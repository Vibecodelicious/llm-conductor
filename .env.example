# LLM Conductor - Environment Configuration
# Copy this file to .env and customize as needed

# ====================
# Default Agent
# ====================
# Which AI CLI tool to use by default
# Options: claude, kiro, gemini, cline, aider, codex, cursor, opencode, roo, amp, copilot
DEFAULT_AGENT=claude

# ====================
# Server Settings
# ====================
HOST=0.0.0.0
PORT=8200

# ====================
# Project Settings
# ====================
PROJECT_BASE_DIR=./projects_master
LOG_LEVEL=INFO

# ====================
# Agent Execution
# ====================
# Maximum parallel agents (for fast mode)
MAX_PARALLEL_AGENTS=3

# Default timeout for agent commands (seconds)
DEFAULT_TIMEOUT_SECONDS=300

# ====================
# Custom Agent Paths (Optional)
# ====================
# Override default command paths if needed
# CLAUDE_PATH=/usr/local/bin/claude
# KIRO_PATH=/usr/local/bin/kiro
# GEMINI_PATH=/usr/local/bin/gemini

# ====================
# Development
# ====================
DEBUG=false
